# ========== KEYCLOAK (общие настройки) ==========
KEYCLOAK_REALM=myrealm
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=myadmin
KEYCLOAK_LOG_LEVEL=INFO

# ========== AUTH SERVICE (клиент: auth-service) ==========
AUTH_ENVIRONMENT=development
AUTH_CORS_ORIGINS=["http://localhost:3000"]
AUTH_KEYCLOAK_URL=http://localhost:8082
AUTH_KEYCLOAK_CLIENT_ID=auth-service
AUTH_KEYCLOAK_CLIENT_SECRET=secret
AUTH_KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
AUTH_REFRESH_TOKEN_MAX_AGE=2592000
AUTH_SMTP_HOST=mailhog
AUTH_SMTP_PORT=1025

# ========== PROFILE SERVICE (клиент: account) ==========
PROFILE_KEYCLOAK_URL=http://localhost:8082
PROFILE_KEYCLOAK_CLIENT_ID=account
PROFILE_KEYCLOAK_CLIENT_SECRET=secret
PROFILE_DATABASE_URL=postgresql://profile_user:profile_pass@postgres-profile:5432/profile_db
PROFILE_REDPANDA_CONSUMER_GROUP=profile-service-group
PROFILE_MEDIA_SERVICE_URL=http://media-service:8000
PROFILE_SERVICE_ID=profile-service

# ========== PROJECT SERVICE ==========
PROJECT_DATABASE_URL=postgresql://user:password@postgres-project:5432/project_db

# ========== FEED SERVICE (ELIXIR) ==========
# FEED_DATABASE_URL=ecto://feed_user:feed_pass@postgres-feed:5432/feed_db
FEED_SECRET_KEY_BASE=secret
# FEED_MEDIA_SERVICE_TOKEN=dev-feed-token

# ========== MEDIA SERVICE (ELIXIR) ==========
MEDIA_DATABASE_URL=ecto://media_user:media_pass@postgres-media:5432/media_db
MEDIA_SECRET_KEY_BASE=secret

# ========== MINIO ==========
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ========== FRONTEND ==========
NEXT_PUBLIC_API_URL=http://localhost:8080